{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readiness",
  "description": "Person decision: GET /api/projects/{project}/readiness",
  "method": "GET",
  "path": "/api/projects/{project}/readiness",
  "query": [],
  "request": null,
  "response": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "draft_seq": {
        "type": "integer"
      },
      "ready": {
        "type": "boolean"
      },
      "has_changes": {
        "type": "boolean"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "repairs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "problems": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "required": [
      "ok",
      "draft_seq",
      "ready",
      "has_changes",
      "error",
      "repairs",
      "problems"
    ],
    "additionalProperties": false
  },
  "error": {
    "$ref": "#/$defs/error_body"
  },
  "$defs": {
    "error_body": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "cause": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Every refusal: 401/403 (auth), 404, 409 (changed since read; details.current), 413, 422, 429, 5xx."
    }
  }
}
