    "StoryCostume": {
      "additionalProperties": false,
      "description": "One outfit in a character's wardrobe (guide 7.8, 18).\n\nA Moment puts a character in it through `StoryMoment.costumes`; the outfit\nthen holds for that character through the rest of the episode until\nanother Moment changes it (`story_costume`). Narrative Canon: changing\nan outfit's look makes the Takes that show it stale.",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "visual_anchors": {
          "items": {
            "type": "string"
