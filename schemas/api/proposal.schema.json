{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proposal",
  "description": "One proposal with its changes",
  "method": "GET",
  "path": "/api/projects/{project}/proposals/{proposal}",
  "query": [],
  "request": null,
  "response": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "raised_by": {
        "type": "string"
      },
      "raised_at": {
        "type": "integer"
      },
      "source": {
        "type": "string",
        "enum": [
          "rejection_note",
          "comparison",
          "direct"
        ]
      },
      "source_take_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source_note": {
        "type": [
          "string",
          "null"
        ]
      },
      "base_revision": {
        "type": [
          "string",
          "null"
        ]
      },
      "base_seq": {
        "type": "integer"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "approved",
          "declined",
          "withdrawn"
        ]
      },
      "server_status": {
        "type": "string",
        "enum": [
          "applied",
          "conflicted",
          "withdrawn",
          "approved",
          "discarded"
        ]
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "decided_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "decided_at": {
        "type": [
          "integer",
          "null"
        ]
      },
      "decision_note": {
        "type": [
          "string",
          "null"
        ]
      },
      "resulting_revision": {
        "type": [
          "string",
          "null"
        ]
      },
      "changes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/field_change"
        }
      },
      "changes_complete": {
        "type": "boolean"
      }
    },
    "required": [
      "proposal_id",
      "project_id",
      "title",
      "summary",
      "raised_by",
      "raised_at",
      "source",
      "source_take_ids",
      "source_note",
      "base_revision",
      "base_seq",
      "status",
      "server_status",
      "conflicts",
      "decided_by",
      "decided_at",
      "decision_note",
      "resulting_revision",
      "changes",
      "changes_complete"
    ],
    "additionalProperties": false
  },
  "error": {
    "$ref": "#/$defs/error_body"
  },
  "$defs": {
    "canon_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error_body": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "cause": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Every refusal: 401/403 (auth), 404, 409 (changed since read; details.current), 413, 422, 429, 5xx."
    },
    "field_change": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "node_title": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "added",
            "changed",
            "removed"
          ]
        },
        "before": {
          "$ref": "#/$defs/canon_value"
        },
        "after": {
          "$ref": "#/$defs/canon_value"
        }
      },
      "required": [
        "node",
        "node_title",
        "field",
        "op",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "description": "One field of one story node a revision changed; node keys as the ledger's depends_on."
    }
  }
}
