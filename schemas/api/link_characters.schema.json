{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "link_characters",
  "description": "Person decision: POST /api/projects/{project}/links/{link}/link",
  "method": "POST",
  "path": "/api/projects/{project}/links/{link}/link",
  "query": [],
  "request": {
    "type": "object",
    "properties": {
      "expected_seq": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "expected_seq"
    ],
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "applied": {
        "const": true
      },
      "link_id": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "enum": [
          "proposed",
          "linked",
          "unlinked"
        ]
      },
      "seq": {
        "type": "integer"
      },
      "ends": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "character_id": {
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "character_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "ok",
      "applied",
      "link_id",
      "state",
      "seq",
      "ends"
    ],
    "additionalProperties": false
  },
  "error": {
    "$ref": "#/$defs/error_body"
  },
  "$defs": {
    "error_body": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "cause": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Every refusal: 401/403 (auth), 404, 409 (changed since read; details.current), 413, 422, 429, 5xx."
    }
  }
}
