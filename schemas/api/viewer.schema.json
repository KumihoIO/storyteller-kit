{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "viewer",
  "description": "The caller's roles here",
  "method": "GET",
  "path": "/api/projects/{project}/me",
  "query": [],
  "request": null,
  "response": {
    "$ref": "#/$defs/member"
  },
  "error": {
    "$ref": "#/$defs/error_body"
  },
  "$defs": {
    "error_body": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "cause": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Every refusal: 401/403 (auth), 404, 409 (changed since read; details.current), 413, 422, 429, 5xx."
    },
    "member": {
      "type": "object",
      "properties": {
        "member_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/story_role"
          }
        }
      },
      "required": [
        "member_id",
        "name",
        "roles"
      ],
      "additionalProperties": false
    },
    "story_role": {
      "description": "A member's role in a story project.",
      "type": "string",
      "enum": [
        "writer",
        "director",
        "producer",
        "reviewer",
        "viewer"
      ]
    }
  }
}
