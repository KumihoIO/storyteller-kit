{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnostics",
  "description": "Person decision: GET /api/projects/{project}/diagnostics",
  "method": "GET",
  "path": "/api/projects/{project}/diagnostics",
  "query": [],
  "request": null,
  "response": {
    "type": "object",
    "additionalProperties": true,
    "description": "Directors: background failures on this project."
  },
  "error": {
    "$ref": "#/$defs/error_body"
  },
  "$defs": {
    "error_body": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "cause": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Every refusal: 401/403 (auth), 404, 409 (changed since read; details.current), 413, 422, 429, 5xx."
    }
  }
}
