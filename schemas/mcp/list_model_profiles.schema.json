{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_model_profiles",
  "description": "The list_model_profiles tool contract of 9miho-storyteller's MCP server (generated).",
  "profiles": [
    "granular",
    "guided"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "maxLength": 200
      },
      "makes": {
        "type": "string",
        "enum": [
          "image",
          "video"
        ]
      },
      "cursor": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 32
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "profiles": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "total": {
        "type": [
          "integer",
          "null"
        ]
      },
      "more_available": {
        "type": "boolean"
      },
      "next_cursor": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 32
      }
    },
    "required": [
      "profiles",
      "more_available"
    ],
    "additionalProperties": false
  }
}
