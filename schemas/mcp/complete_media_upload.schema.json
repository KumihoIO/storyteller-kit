{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "complete_media_upload",
  "description": "The complete_media_upload tool contract of 9miho-storyteller's MCP server (generated).",
  "profiles": [
    "granular",
    "guided"
  ],
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "project_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u001f]+$"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "description": "A fresh UUID per new action; reuse only to retry the same call."
      },
      "upload_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u001f]+$"
      }
    },
    "required": [
      "project_id",
      "idempotency_key",
      "upload_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "project_id": {
        "type": "string"
      },
      "upload_id": {
        "type": "string"
      },
      "result_ref": {
        "type": "string"
      },
      "sha256": {
        "type": "string"
      },
      "size_bytes": {
        "type": "integer"
      },
      "content_type": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "already_kept": {
        "type": "boolean"
      },
      "next_steps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "result_ref",
      "sha256",
      "content_type",
      "kind",
      "next_steps"
    ],
    "additionalProperties": false
  }
}
